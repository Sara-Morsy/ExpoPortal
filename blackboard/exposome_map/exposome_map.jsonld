  "@graph": [
    {
      "@id": "em:AdverseOutcome",
      "@type": "owl:Class",
      "definition": "Health effect at organ or organism level (adverse outcome in adverse outcome pathway terms).",
      "em:stageOrder": 8,
      "label": "adverse outcome",
      "rdfs:subClassOf": {
        "@id": "em:Node"
      }
    },
    {
      "@id": "em:AnalyticalMethod",
      "@type": "owl:Class",
      "definition": "Instrumental method used to analyse samples.",
      "em:stageOrder": 11,
      "label": "analytical method",
      "rdfs:subClassOf": {
        "@id": "em:Node"
      }
    },
    {
      "@id": "em:ChemicalRole",
      "@type": "owl:Class",
      "definition": "Function a chemical has in a product.",
      "em:stageOrder": 3,
      "label": "chemical role",
      "rdfs:subClassOf": {
        "@id": "em:Node"
      }
    },
    {
      "@id": "em:Emission",
      "@type": "owl:Class",
      "definition": "Release of material from a source into the environment.",
      "em:stageOrder": 2,
      "label": "emission",
      "rdfs:subClassOf": {
        "@id": "em:Node"
      }
    },
    {
      "@id": "em:ExposomeAssessment",
      "@type": "owl:Class",
      "definition": "Approach to measure the external or internal exposome.",
      "em:stageOrder": 11,
      "label": "exposome assessment",
      "rdfs:subClassOf": {
        "@id": "em:Node"
      }
    },
    {
      "@id": "em:ExposureRoute",
      "@type": "owl:Class",
      "definition": "Way a stressor enters the organism.",
      "em:stageOrder": 5,
      "label": "exposure route",
      "rdfs:subClassOf": {
        "@id": "em:Node"
      }
    },
    {
      "@id": "em:KeyEvent",
      "@type": "owl:Class",
      "definition": "Measurable biological change between exposure and adverse outcome (key event in adverse outcome pathway terms).",
      "em:stageOrder": 7,
      "label": "biological process (key event)",
      "rdfs:subClassOf": {
        "@id": "em:Node"
      }
    },
    {
      "@id": "em:Matrix",
      "@type": "owl:Class",
      "definition": "Body fluid or tissue sampled in human biomonitoring.",
      "em:stageOrder": 11,
      "label": "biomonitoring matrix",
      "rdfs:subClassOf": {
        "@id": "em:Node"
      }
    },
    {
      "@id": "em:Modifier",
      "@type": "owl:Class",
      "definition": "Characteristic of the individual that changes the biological response to an exposure.",
      "em:stageOrder": 9,
      "label": "modifier",
      "rdfs:subClassOf": {
        "@id": "em:Node"
      }
    },
    {
      "@id": "em:Node",
      "@type": "owl:Class",
      "label": "map node"
    },
    {
      "@id": "em:OmicsMethod",
      "@type": "owl:Class",
      "definition": "Omics technology with which a biological process can be measured.",
      "em:stageOrder": 10,
      "label": "omics method",
      "rdfs:subClassOf": {
        "@id": "em:Node"
      }
    },
    {
      "@id": "em:Organ",
      "@type": "owl:Class",
      "definition": "Organ or tissue where the stressor acts.",
      "em:stageOrder": 6,
      "label": "organ",
      "rdfs:subClassOf": {
        "@id": "em:Node"
      }
    },
    {
      "@id": "em:ProcessGroup",
      "@type": "owl:Class",
      "definition": "Group of biological processes, drawn as a bracket on the board.",
      "em:stageOrder": 7,
      "label": "process group",
      "rdfs:subClassOf": {
        "@id": "em:Node"
      }
    },
    {
      "@id": "em:Receptor",
      "@type": "owl:Class",
      "definition": "Organism or population group that is exposed.",
      "em:stageOrder": 6,
      "label": "receptor organism / population group",
      "rdfs:subClassOf": {
        "@id": "em:Node"
      }
    },
    {
      "@id": "em:SamplingMethod",
      "@type": "owl:Class",
      "definition": "Sampler or sampling mode used to measure external exposure.",
      "em:stageOrder": 11,
      "label": "sampling method",
      "rdfs:subClassOf": {
        "@id": "em:Node"
      }
    },
    {
      "@id": "em:Source",
      "@type": "owl:Class",
      "definition": "Origin of an emission or chemical, natural or man-made.",
      "em:stageOrder": 1,
      "label": "source",
      "rdfs:subClassOf": {
        "@id": "em:Node"
      }
    },
    {
      "@id": "em:Stressor",
      "@type": "owl:Class",
      "definition": "Chemical or particle that an organism is exposed to (stressor in adverse outcome pathway terms).",
      "em:stageOrder": 3,
      "label": "chemical / stressor",
      "rdfs:subClassOf": {
        "@id": "em:Node"
      }
    },
    {
      "@id": "em:TransformationProcess",
      "@type": "owl:Class",
      "definition": "Environmental reaction that converts a chemical into a transformation product.",
      "em:stageOrder": 4,
      "label": "transformation process",
      "rdfs:subClassOf": {
        "@id": "em:Node"
      }
    },
    {
      "@id": "em:Workflow",
      "@type": "owl:Class",
      "definition": "A path through the map, from a source to the biological response.",
      "label": "workflow"
    },
    {
      "@id": "em:ao_asthma",
      "@type": "em:AdverseOutcome",
      "definition": "Chronic inflammatory disease of the airways.",
      "em:board": 1,
      "em:ink": "purple",
      "em:x": {
        "@type": "xsd:decimal",
        "@value": "10.3"
      },
      "em:y": {
        "@type": "xsd:decimal",
        "@value": "5.6"
      },
      "label": "asthma",
      "labelMatch": [
        "http://purl.obolibrary.org/obo/DOID_2841",
        "http://purl.obolibrary.org/obo/HP_0002099",
        "http://purl.obolibrary.org/obo/MONDO_0004979",
        "https://bioportal.bioontology.org/ontologies/DREDTO#asthma",
        "https://saref.etsi.org/saref4ehaw/Asthma"
      ]
    },
    {
      "@id": "em:ao_fibrosis",
      "@type": "em:AdverseOutcome",
      "altLabel": "lung fibrosis",
      "definition": "Scarring of lung tissue by excess connective tissue.",
      "em:board": 1,
      "em:ink": "purple",
      "em:x": {
        "@type": "xsd:decimal",
        "@value": "10.3"
      },
      "em:y": {
        "@type": "xsd:decimal",
        "@value": "3.0"
      },
      "hiddenLabel": "pulmonary fibrosis",
      "label": "fibrosis",
      "labelMatch": [
        "http://purl.obolibrary.org/obo/DOID_3770",
        "http://purl.obolibrary.org/obo/HP_0002206",
        "http://purl.obolibrary.org/obo/MONDO_0002771",
        "http://purl.obolibrary.org/obo/TXPO_0000219",
        "http://www.ebi.ac.uk/efo/EFO_0006890",
        "http://www.ebi.ac.uk/efo/EFO_0009448"
      ]
    },
    {
      "@id": "em:assess_biomonitoring",
      "@type": "em:ExposomeAssessment",
      "altLabel": "human biomonitoring",
      "definition": "Measurement of chemicals or their markers in human body fluids and tissues. Its matrices are marked as a gap on the board.",
      "em:board": 1,
      "em:ink": "purple",
      "em:x": {
        "@type": "xsd:decimal",
        "@value": "8.8"
      },
      "em:y": {
        "@type": "xsd:decimal",
        "@value": "11.1"
      },
      "hiddenLabel": "biological monitoring",
      "label": "biomonitoring",
      "usesMatrix": [
        "em:matrix_blood",
        "em:matrix_hair",
        "em:matrix_milk",
        "em:matrix_saliva",
        "em:matrix_urine"
      ]
    },
    {
      "@id": "em:assess_external_exposome",
      "@type": "em:ExposomeAssessment",
      "assessedBy": [
        "em:sampler_individual",
        "em:sampler_wearable_silicone"
      ],
      "characterises": "em:route_inhalation",
      "definition": "Measurement of exposure outside the body.",
      "em:board": 1,
      "em:ink": "purple",
      "em:x": {
        "@type": "xsd:decimal",
        "@value": "5.0"
      },
      "em:y": {
        "@type": "xsd:decimal",
        "@value": "9.6"
      },
      "label": "external exposome",
      "usesMethod": [
        "em:method_hrms_nontargeted",
        "em:method_hrms_targeted"
      ]
    },
    {
      "@id": "em:assess_internal_exposome",
      "@type": "em:ExposomeAssessment",
      "assessedBy": "em:assess_biomonitoring",
      "characterises": "em:group_biological_response",
      "definition": "Measurement of exposure and its effects inside the body.",
      "em:board": 1,
      "em:ink": "purple",
      "em:x": {
        "@type": "xsd:decimal",
        "@value": "7.0"
      },
      "em:y": {
        "@type": "xsd:decimal",
        "@value": "9.9"
      },
      "label": "internal exposome",
      "usesMethod": [
        "em:method_hrms_nontargeted",
        "em:method_hrms_targeted"
      ]
    },
    {
      "@id": "em:assessedBy",
      "@type": "owl:ObjectProperty",
      "label": "assessed by"
    },
    {
      "@id": "em:automaticMatch",
      "@type": "owl:ObjectProperty",
