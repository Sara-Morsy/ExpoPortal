flowchart LR
  subgraph cls_Source["source"]
    source_anthropogenic["anthropogenic"]
    source_biogenic["biogenic"]
    source_tires["tires"]
  end
  subgraph cls_Emission["emission"]
    emission_non_exhaust["non-exhaust emissions"]
    emission_tire_road_wear["tire-road wear emissions"]
  end
  subgraph cls_Stressor["chemical / stressor"]
    chem_6ppd["6PPD"]
    chem_6ppd_quinone["6PPD-Q"]
    chem_alpha_pinene["α-pinene"]
    chem_hydroxyl_radical["•OH"]
    chem_ozone["ozone"]
    particle_micro_nanoplastics["micro-nanoplastics"]
    particle_trwp["TRWPs"]
  end
  subgraph cls_ChemicalRole["chemical role"]
    role_antioxidant["anti-oxidant"]
    role_plasticizer["plasticizer"]
  end
  subgraph cls_TransformationProcess["transformation process"]
    proc_heterogeneous_oxidation["heterogeneous oxidation"]
    proc_ozonolysis["ozonolysis"]
  end
  subgraph cls_ExposureRoute["exposure route"]
    route_inhalation["inhalation"]
  end
  subgraph cls_Organ["organ"]
    organ_lung["lung"]
  end
  subgraph cls_Receptor["receptor organism / population group"]
    pop_female_20["female, 20 yrs"]
    pop_male_60["male, 60 yrs"]
    receptor_coho_salmon["coho salmon"]
  end
  subgraph cls_Modifier["modifier"]
    mod_age["age"]
    mod_genes["genes"]
    mod_sex_gender["gender"]
    mod_smoking_history["smoking history"]
  end
  subgraph cls_OmicsMethod["omics method"]
    omics_adductomics["adductomics"]
    omics_genomics["genome"]
    omics_lipidomics["lipidomics"]
    omics_metabolomics["metabolomics"]
    omics_proteomics["proteomics"]
  end
  subgraph cls_AnalyticalMethod["analytical method"]
    method_hrms_nontargeted["non-targeted HRMS"]
    method_hrms_targeted["targeted HRMS"]
  end
  subgraph cls_Matrix["biomonitoring matrix"]
    matrix_blood["blood"]
    matrix_hair["hair"]
    matrix_milk["milk"]
    matrix_saliva["saliva"]
    matrix_urine["urine"]
  end
  subgraph cls_ExposomeAssessment["exposome assessment"]
    assess_biomonitoring["biomonitoring"]
    assess_external_exposome["external exposome"]
    assess_internal_exposome["internal exposome"]
  end
  subgraph cls_SamplingMethod["sampling method"]
    mode_active_sampling["active sampling"]
    mode_passive_sampling["passive sampling"]
    sampler_individual["individual samplers"]
    sampler_wearable_silicone["wearable silicone samplers"]
  end
  subgraph group_biological_response["biological response"]
    ao_asthma["asthma"]
    ao_fibrosis["fibrosis"]
    ke_allergic_response["allergy"]
    ke_catalase["catalase"]
    ke_emt["epithelial-mesenchymal transition"]
    ke_eosinophils["eosinophils"]
    ke_erk_dependent["ERK-dependent"]
    ke_erk_independent["ERK-independent"]
    ke_inflammation["inflammation"]
    ke_macrophages["macrophages"]
    ke_nfkb["NF-κB"]
    ke_ros_pathway["ROS pathway"]
    ke_signalling_pathways["signalling pathways"]
    ke_unjamming_transition["unjamming transition"]
  end

  assess_biomonitoring -.->|"samples"| matrix_blood
  assess_biomonitoring -.->|"samples"| matrix_hair
  assess_biomonitoring -.->|"samples"| matrix_milk
  assess_biomonitoring -.->|"samples"| matrix_saliva
  assess_biomonitoring -.->|"samples"| matrix_urine
  assess_external_exposome -.->|"assessed by"| sampler_individual
  assess_external_exposome -.->|"assessed by"| sampler_wearable_silicone
  assess_external_exposome -.->|"characterises"| route_inhalation
  assess_external_exposome -.->|"uses"| method_hrms_nontargeted
  assess_external_exposome -.->|"uses"| method_hrms_targeted
  assess_internal_exposome -.->|"assessed by"| assess_biomonitoring
  assess_internal_exposome -.->|"characterises"| group_biological_response
  assess_internal_exposome -.->|"uses"| method_hrms_nontargeted
  assess_internal_exposome -.->|"uses"| method_hrms_targeted
  chem_6ppd -->|"exposure via"| route_inhalation
  chem_6ppd -.->|"has role"| role_antioxidant
  chem_6ppd -.->|"has role"| role_plasticizer
  chem_6ppd -->|"input of"| proc_heterogeneous_oxidation
  chem_6ppd -->|"input of"| proc_ozonolysis
  chem_6ppd_quinone -->|"exposure via"| route_inhalation
  chem_6ppd_quinone -->|"toxic to"| receptor_coho_salmon
  chem_alpha_pinene -->|"exposure via"| route_inhalation
  chem_hydroxyl_radical -->|"input of"| proc_heterogeneous_oxidation
  chem_ozone -->|"input of"| proc_ozonolysis
  emission_tire_road_wear -.->|"is a kind of"| emission_non_exhaust
  emission_tire_road_wear -->|"emits"| particle_trwp
  ke_allergic_response -->|"leads to"| ke_eosinophils
  ke_allergic_response -->|"leads to"| ke_macrophages
  ke_catalase -->|"modulates"| ke_ros_pathway
  ke_emt -.->|"leads to (AOP knowledge)"| ao_fibrosis
  ke_eosinophils -.->|"leads to (AOP knowledge)"| ke_inflammation
  ke_erk_dependent -.->|"is a kind of"| ke_signalling_pathways
  ke_erk_dependent -->|"leads to"| ao_asthma
  ke_erk_independent -.->|"is a kind of"| ke_signalling_pathways
  ke_erk_independent -->|"leads to"| ao_asthma
  ke_inflammation -.->|"leads to (AOP knowledge)"| ao_asthma
  ke_inflammation -.->|"leads to (AOP knowledge)"| ke_emt
  ke_macrophages -.->|"leads to (AOP knowledge)"| ke_inflammation
  ke_nfkb -.->|"is a kind of"| ke_signalling_pathways
  ke_nfkb -.->|"leads to (AOP knowledge)"| ke_inflammation
  ke_ros_pathway -.->|"leads to (AOP knowledge)"| ke_nfkb
  ke_signalling_pathways -->|"leads to"| ao_fibrosis
  ke_signalling_pathways -->|"leads to"| ke_emt
  ke_signalling_pathways -->|"leads to"| ke_unjamming_transition
  mod_age -.->|"modifies"| group_biological_response
  mod_genes -.->|"modifies"| group_biological_response
  mod_sex_gender -.->|"modifies"| group_biological_response
  mod_smoking_history -.->|"modifies"| group_biological_response
  omics_adductomics -.->|"measures"| group_biological_response
  omics_genomics -.->|"measures"| ke_nfkb
  omics_genomics -.->|"measures"| ke_ros_pathway
  omics_lipidomics -.->|"measures"| group_biological_response
  omics_metabolomics -.->|"measures"| group_biological_response
  omics_proteomics -.->|"measures"| ke_catalase
  organ_lung -->|"site of"| group_biological_response
  particle_trwp -.->|"is a kind of"| particle_micro_nanoplastics
  pop_female_20 -.->|"has characteristic"| mod_age
  pop_female_20 -.->|"has characteristic"| mod_sex_gender
  pop_male_60 -.->|"has characteristic"| mod_age
  pop_male_60 -.->|"has characteristic"| mod_sex_gender
  proc_ozonolysis -->|"gives"| chem_6ppd_quinone
  route_inhalation -->|"targets"| organ_lung
  sampler_individual -.->|"sampling mode"| mode_active_sampling
  sampler_individual -.->|"sampling mode"| mode_passive_sampling
  sampler_wearable_silicone -.->|"sampling mode"| mode_passive_sampling
  source_anthropogenic -->|"includes"| source_tires
  source_biogenic -->|"emits"| chem_alpha_pinene
  source_tires -->|"contains"| chem_6ppd
  source_tires -->|"emits"| emission_tire_road_wear

